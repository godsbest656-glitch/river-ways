{
  "name": "riverwayse-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-static-pages.mjs && node scripts/validate-static-pages.mjs",
    "preview": "vite preview",
    "check": "npm run build",
    "test:api": "node --test tests/api/*.test.js",
    "test": "npm run test:api && npm run test:portfolio",
    "test:portfolio": "node --test tests/portfolio/*.test.js",
    "validate:portfolio": "node scripts/validate-portfolio.mjs",
    "validate:routes": "node scripts/validate-static-pages.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
