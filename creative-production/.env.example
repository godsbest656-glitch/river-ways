# Copy these values into your local secret manager or untracked shell environment.
# Never commit real Cloudflare Access service-token credentials.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional; defaults to the River Ways Studio API.
STUDIO_API_BASE=

# Optional; defaults to <repository-root>/production.
RIVER_WAYS_PRODUCTION_ROOT=

# Optional; defaults to 5000 ms (clamped to 1000–60000 ms).
STUDIO_WORKER_POLL_MS=5000

# Optional strategy-only model route. Leave unset to use the deterministic draft adapter.
# Store the API key in the named environment variable; never put the key in this JSON.
# STUDIO_MODEL_ROUTES_JSON={"strategy":{"provider":"openai-compatible","baseUrl":"https://api.openai.com/v1","model":"<explicit-model-id>","apiKeyEnv":"OPENAI_API_KEY"}}
# OPENAI_API_KEY=
