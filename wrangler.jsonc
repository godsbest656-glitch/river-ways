{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "river-ways",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "oluwafemi@riverwayse.com"
  },
  "observability": {
    "enabled": true
  }
}
