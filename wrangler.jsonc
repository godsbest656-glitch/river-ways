{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "river-ways",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "riverwayse-leads",
      "database_id": "195d3511-224c-4ac3-b033-28aef990c549",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "LEADS_DB",
        "database_name": "riverwayse-leads-preview",
        "database_id": "3233e117-d7ae-4e41-ac27-c172aab71e6d",
        "migrations_dir": "migrations"
      }
    ]
  }
}
